# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# GiftUp (gift card redemption) — generate at https://giftup.app/integrations/api-keys/
GIFTUP_API_KEY=your_giftup_api_key
# Set to true to redeem against GiftUp's test data instead of real cards
GIFTUP_TEST_MODE=false

# ChatBase (Field) — API key from chatbase.co → Settings → API keys. Server-side only.
CHATBASE_API_KEY=your_chatbase_api_key
# The Field agent id (defaults to the live agent if unset)
CHATBASE_AGENT_ID=ZQ2IY-75iqOVAi4nuCUFU

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=3001
